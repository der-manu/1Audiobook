-  val eventStart = _eventStart.asSharedFlow()
-
-  fun checkPurchasesAvailability(context: Context) {
-    _stateStart.value = _stateStart.value.copy(isLoading = true)
-    RuStoreBillingClient.checkPurchasesAvailability(context)
